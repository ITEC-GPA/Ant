<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>Ant.GrasshopperPlugIn</RootNamespace>
    <OutputType>Library</OutputType>
    <IsWebBootstrapper>false</IsWebBootstrapper>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>1.1.4</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
	  <PlatformTarget>x64</PlatformTarget>
	  <GmshNetRoot>$(MSBuildThisFileDirectory)..\..\Gmsh.Net</GmshNetRoot>
    <GeometryArtifactsRoot>$(MSBuildThisFileDirectory)..\bin\geometry</GeometryArtifactsRoot>
	  <TargetExt>.gha</TargetExt>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|AnyCPU'">
    <OutputPath>..\bin\</OutputPath>
    <CodeAnalysisIgnoreBuiltInRules>false</CodeAnalysisIgnoreBuiltInRules>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <OutputPath>..\bin\</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Views\**" />
    <EmbeddedResource Remove="Views\**" />
    <None Remove="Views\**" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="GMesh">
      <HintPath>$(GeometryArtifactsRoot)\bin\GMesh\release\GMesh.dll</HintPath>
    </Reference>
    <Reference Include="GMsh.Net">
      <HintPath>$(MSBuildThisFileDirectory)..\bin\gmsh\bin\GMsh.Net\release\GMsh.Net.dll</HintPath>
    </Reference>
    <Reference Include="GPCGeometry">
      <HintPath>$(GeometryArtifactsRoot)\bin\GPCGeometry\release\GPCGeometry.dll</HintPath>
    </Reference>
    <Reference Include="GPCUtilities">
      <HintPath>..\..\Utilities\GPCUtilities\bin\Release\netstandard2.0\GPCUtilities.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Resources\ReferenceObjectsIcon.png" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Resources\SetUserDataIcon.png" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Resources\GetUserDataIcon.png" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Resources\UpdateGeometryUserDataIcon.png" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Resources\GetPropertiesIcon.png" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Resources\FilterUserDataIcon.png" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Resources\FilterPropertiesIcon.png" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Resources\GridDisposeIcon.png" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Resources\BakeUserDataIcon.png" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Resources\StopIcon.png" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Resources\SwitchIcon.png" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Resources\RecomputeIcon.png" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Resources\SetGenePoolIcon.png" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Resources\IfIcon.png" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Resources\AutoOrientIcon.png" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Resources\AddUserDataIcon.png" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Resources\GetUserValuesIcon.png" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Resources\GetParamDataIcon.png" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Resources\JoinOffsetCurvesIcon.png" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Resources\SubStringIcon.png" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Resources\GetDocPathIcon.png" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Resources\MeshIcon.png" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Resources\MeshRefinementIcon.png" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Resources\CleanGeometryIcon.png" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Grasshopper" Version="8.19.25132.1001" ExcludeAssets="runtime" />
    <PackageReference Include="MathNet.Numerics" Version="5.0.0" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="9.0.5" />
    <PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="RhinoCommon" Version="8.19.25132.1001" ExcludeAssets="runtime" />
    <PackageReference Include="System.Buffers" Version="4.6.1" />
    <PackageReference Include="System.Collections.Immutable" Version="9.0.5" />
    <PackageReference Include="System.Memory" Version="4.6.3" />
    <PackageReference Include="System.Numerics.Vectors" Version="4.6.1" />
    <PackageReference Include="System.Reflection.Metadata" Version="9.0.5" />
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.1.2" />
    <PackageReference Include="System.Runtime.InteropServices.RuntimeInformation" Version="4.3.0" />
    <PackageReference Include="System.Text.Encodings.Web" Version="9.0.5" />
    <PackageReference Include="System.Threading.Tasks.Extensions" Version="4.6.3" />
    <PackageReference Include="System.ValueTuple" Version="4.6.1" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="_obj\Debug\.NETFramework,Version=v4.7.2.AssemblyAttributes.cs" />
    <Compile Remove="_obj\Debug\Sentry.Attributes.cs" />
    <Compile Remove="_obj\Release\.NETFramework,Version=v4.7.2.AssemblyAttributes.cs" />
    <Compile Remove="_obj\Release\Sentry.Attributes.cs" />
  </ItemGroup>
  <!-- Read the native version from the binding project, so managed/native updates stay paired. -->
  <Target Name="CopyGmshNative" AfterTargets="Build">
    <XmlPeek XmlInputPath="$(GmshNetRoot)\src\GMsh.Net\GMsh.Net.csproj" Query="/Project/PropertyGroup/GmshNativeVersion/text()">
      <Output TaskParameter="Result" PropertyName="GmshNativeVersion" />
    </XmlPeek>
    <Error Condition="'$(GmshNativeVersion)' == ''" Text="GmshNativeVersion is missing from GMsh.Net.csproj." />
    <Copy SourceFiles="$(GmshNetRoot)\dll\windows\gmsh-$(GmshNativeVersion).dll" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>
  <!-- The commit of the build, read at load by PluginBuildCheck; the informational version stays without it. -->
  <Target Name="AddBuildCommitMetadata" BeforeTargets="GetAssemblyAttributes" DependsOnTargets="InitializeSourceControlInformation" Condition="'$(SourceControlInformationFeatureSupported)' == 'true'">
    <ItemGroup>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute" Condition="'$(SourceRevisionId)' != ''">
        <_Parameter1>BuildCommit</_Parameter1>
        <_Parameter2>$(SourceRevisionId)</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>
  <PropertyGroup>
    <FallbackCulture>en-US</FallbackCulture>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|AnyCPU'">
    <StartProgram>C:\Program Files\Rhino 8\System\Rhino.exe</StartProgram>
    <StartArguments>
    </StartArguments>
    <StartAction>Program</StartAction>
  </PropertyGroup>
</Project>



